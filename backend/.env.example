# ---------------------------------------------------------------------------
# MedAI backend environment configuration
# ---------------------------------------------------------------------------
# Copy to .env for local development and fill in real values.
# NEVER commit a real .env containing production secrets to Git.
# ---------------------------------------------------------------------------

# Database. Production should use PostgreSQL. Development defaults to
# backend/instance/medai-dev.sqlite3 when DATABASE_URL is unset.
# To explicitly select another database:
#   DATABASE_URL=sqlite:///instance/medai-dev.sqlite3
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/medai
DATABASE_URL=postgresql+psycopg2://medai:medai@localhost:5432/medai

# Flask secret used to sign session cookies (not JWTs). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-secret

# JWT signing key. Generate with secrets.token_hex(32) in production.
JWT_SECRET_KEY=change-me-generate-a-jwt-secret

# Access tokens expire after this many minutes.
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
# Refresh tokens expire after this many days.
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# --- Patient agent AI provider ----------------------------------------------
# Which adapter answers POST /api/agent/chat.
# LEAVE THIS EMPTY for the default behaviour: the endpoint honestly answers
# "model_unavailable" and never fabricates clinical text.
#
#   AI_PROVIDER=teammate   the modelling teammate's clinical API
AI_PROVIDER=

# --- AI model ---------------------------------------------------------------
# Trained AI model artifact path + optional feature schema.
# The model IS NOT shipped in this repository — it is provided by the modelling
# teammate. Until AI_MODEL_PATH points at the real artifact, POST /predict and
# POST /api/cases/<id>/ai-recommendation return 503 with a clear message.
AI_MODEL_PATH=/path/to/trained_model.pkl
# Optional JSON sidecar describing the features the model expects
# (column names/order). If absent the loader will try to read feature
# names straight from the artifact (e.g. sklearn feature_names_in_).
AI_FEATURE_SCHEMA_PATH=/path/to/feature_schema.json
# Framework auto-detected from the file extension (.pkl/.joblib/.pt/.onnx/.keras)
AI_MODEL_FORMAT=auto

# CORS origins (comma separated) for the mobile + web apps.
CORS_ORIGINS=http://localhost:4000,http://localhost:5173,http://localhost:8081

# Confidence thresholds (0..1) that map model probability -> High/Medium/Low.
AI_CONFIDENCE_HIGH=0.80
AI_CONFIDENCE_MEDIUM=0.55
